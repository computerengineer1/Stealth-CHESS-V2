<?xml version="1.0" encoding="UTF-8"?>
<!--
  StealthDevice - Native HWID plugin (Cordova)
  Android : Settings.Secure.ANDROID_ID
  iOS     : identifierForVendor
  JS API  : window.StealthDevice.getHwid(success, error)
-->
<plugin id="com.stealthchess.device" name="StealthDevice" version="1.0.0"
        xmlns="http://apache.org/cordova/ns/plugins/1.0"
        xmlns:android="http://schemas.android.com/apk/res/android">
    <js-module name="StealthDevice" src="www/stealthdevice.js">
        <clobbers target="StealthDevice" />
    </js-module>
    <platform name="android">
        <config-file parent="/*" target="res/xml/config.xml">
            <feature name="StealthDevice">
                <param name="android-package" value="com.stealthchess.device.StealthDevice"/>
            </feature>
        </config-file>
        <source-file src="src/android/StealthDevice.java" target-dir="src/com/stealthchess/device"/>
    </platform>
    <platform name="ios">
        <config-file parent="/*" target="config.xml">
            <feature name="StealthDevice">
                <param name="ios-package" value="StealthDevice"/>
            </feature>
        </config-file>
        <source-file src="src/ios/StealthDevice.m"/>
    </platform>
</plugin>
